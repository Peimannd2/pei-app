{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pei-app",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "0d6f1253-2ee9-4898-9369-80396d503d46","database_name": "pei0" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "118294ae1864419a82fb869adb7bf51b" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
